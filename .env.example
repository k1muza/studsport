# Public canonical origin. Keep the verified Vercel origin until the custom domain resolves and serves this deployment.
NEXT_PUBLIC_SITE_URL=https://studsport.vercel.app

# Optional Google Analytics 4 web stream ID. Analytics is disabled when omitted.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Optional direct enquiry delivery through Resend. If any value is absent, the form uses an explicit WhatsApp handoff.
RESEND_API_KEY=
RESEND_FROM_EMAIL=StudSport <enquiries@verified-sending-domain.example>
ENQUIRY_TO_EMAIL=
